{
  "name": "enterprise-frontend-mf",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "dev:host": "pnpm --filter host-portal dev",
    "dev:approval": "pnpm --filter approval-remote dev",
    "dev:integration": "pnpm --filter integration-remote dev",
    "dev:platform": "pnpm --filter platform-remote dev"
  },
  "devDependencies": {
    "@rspack/dev-server": "^2.2.1",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  }
}
