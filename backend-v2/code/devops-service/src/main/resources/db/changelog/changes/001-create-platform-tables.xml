<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-platform-services" author="antigravity">
        <createTable tableName="services">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="display_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="service_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(512)"/>
            <column name="owner_team" type="VARCHAR(64)"/>
            <column name="target_port" type="INT"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="services" indexName="idx_services_code">
            <column name="service_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-service-repositories" author="antigravity">
        <createTable tableName="service_repositories">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_repo_service" references="services(id)"/>
            </column>
            <column name="git_provider" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="repo_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="clone_url_http" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="clone_url_ssh" type="VARCHAR(256)"/>
            <column name="web_url" type="VARCHAR(256)"/>
            <column name="default_branch" type="VARCHAR(32)" defaultValue="main"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex tableName="service_repositories" indexName="idx_repo_service_id">
            <column name="service_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-service-deployments" author="antigravity">
        <createTable tableName="service_deployments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_deployment_service" references="services(id)"/>
            </column>
            <column name="environment" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="k8s_namespace" type="VARCHAR(64)"/>
            <column name="k8s_deployment_name" type="VARCHAR(128)"/>
            <column name="replicas" type="INT" defaultValueNumeric="1"/>
            <column name="health_status" type="VARCHAR(32)" defaultValue="HEALTHY"/>
            <column name="last_deployed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
