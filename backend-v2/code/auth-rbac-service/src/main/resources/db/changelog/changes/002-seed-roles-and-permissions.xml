<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-seed-roles" author="antigravity">
        <insert tableName="roles">
            <column name="id" valueNumeric="1"/>
            <column name="code" value="ROLE_ADMIN"/>
            <column name="name" value="Administrator"/>
            <column name="description" value="Full administrative privileges across all modules"/>
            <column name="is_system" valueBoolean="true"/>
            <column name="status" value="ACTIVE"/>
        </insert>
        <insert tableName="roles">
            <column name="id" valueNumeric="2"/>
            <column name="code" value="ROLE_INVENTORY_ADMIN"/>
            <column name="name" value="Inventory Manager"/>
            <column name="description" value="Privileges to manage warehouses and stock adjustments"/>
            <column name="is_system" valueBoolean="false"/>
            <column name="status" value="ACTIVE"/>
        </insert>
        <insert tableName="roles">
            <column name="id" valueNumeric="3"/>
            <column name="code" value="ROLE_ORDER_ADMIN"/>
            <column name="name" value="Order Approver"/>
            <column name="description" value="Privileges to review, approve and cancel orders"/>
            <column name="is_system" valueBoolean="false"/>
            <column name="status" value="ACTIVE"/>
        </insert>
    </changeSet>

    <changeSet id="003-seed-permissions" author="antigravity">
        <!-- Inventory Permissions -->
        <insert tableName="permissions">
            <column name="id" valueNumeric="1"/>
            <column name="code" value="inventory:read"/>
            <column name="resource" value="inventory"/>
            <column name="action" value="read"/>
            <column name="description" value="View warehouses and stock quantities"/>
        </insert>
        <insert tableName="permissions">
            <column name="id" valueNumeric="2"/>
            <column name="code" value="inventory:stock:adjust"/>
            <column name="resource" value="inventory"/>
            <column name="action" value="adjust"/>
            <column name="description" value="Adjust stock quantities in warehouse"/>
        </insert>

        <!-- Order Permissions -->
        <insert tableName="permissions">
            <column name="id" valueNumeric="3"/>
            <column name="code" value="order:read"/>
            <column name="resource" value="order"/>
            <column name="action" value="read"/>
            <column name="description" value="View admin orders"/>
        </insert>
        <insert tableName="permissions">
            <column name="id" valueNumeric="4"/>
            <column name="code" value="order:approve"/>
            <column name="resource" value="order"/>
            <column name="action" value="approve"/>
            <column name="description" value="Approve pending customer orders"/>
        </insert>
        <insert tableName="permissions">
            <column name="id" valueNumeric="5"/>
            <column name="code" value="order:cancel"/>
            <column name="resource" value="order"/>
            <column name="action" value="cancel"/>
            <column name="description" value="Cancel orders"/>
        </insert>
    </changeSet>

    <changeSet id="004-seed-role-permissions" author="antigravity">
        <!-- ROLE_ADMIN gets all permissions (1-5) -->
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="1"/><column name="permission_id" valueNumeric="1"/></insert>
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="1"/><column name="permission_id" valueNumeric="2"/></insert>
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="1"/><column name="permission_id" valueNumeric="3"/></insert>
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="1"/><column name="permission_id" valueNumeric="4"/></insert>
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="1"/><column name="permission_id" valueNumeric="5"/></insert>

        <!-- ROLE_INVENTORY_ADMIN gets inventory permissions (1, 2) -->
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="2"/><column name="permission_id" valueNumeric="1"/></insert>
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="2"/><column name="permission_id" valueNumeric="2"/></insert>

        <!-- ROLE_ORDER_ADMIN gets order permissions (3, 4, 5) -->
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="3"/><column name="permission_id" valueNumeric="3"/></insert>
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="3"/><column name="permission_id" valueNumeric="4"/></insert>
        <insert tableName="role_permissions"><column name="role_id" valueNumeric="3"/><column name="permission_id" valueNumeric="5"/></insert>
    </changeSet>

</databaseChangeLog>
